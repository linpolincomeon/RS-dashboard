  credentials: 'include',
  body: JSON.stringify({
    jsonrpc: '2.0', method: 'call', id: 1,
    params: {
      model: 'sale.order',
      method: 'search_read',
      args: [[['invoice_status','=','to invoice']]],
      kwargs: { fields: ['name','partner_shipping_id','warehouse_id'], limit: 5 }
